# --- DATABASE: CLICKHOUSE (Market Data) ---
CLICKHOUSE_USER=ch_user
CLICKHOUSE_PASSWORD=ch_password
CLICKHOUSE_HOST=analytics_db
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=analytics

# --- DATABASE: POSTGRES (Trade History) ---
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=orders
POSTGRES_HOST=orders_db
POSTGRES_PORT=5432

# --- BROKER: RABBITMQ (Signaling) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbit
RABBITMQ_PORT=5672
RABBITMQ_QUEUE_SIGNALS=trading_signals

# --- EXCHANGES ---
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_REST_URL=https://api.bybit.com
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret
BYBIT_TESTNET=False  # True для тестов, False для реальных денег

BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_REST_URL=https://api.binance.com

# --- STRATEGY SETTINGS ---
TARGET_SYMBOLS_JSON=["ZECUSDT"]
LEVERAGE=1
TRADE_AMOUNT_USDT=20.0
RECV_WINDOW=30000